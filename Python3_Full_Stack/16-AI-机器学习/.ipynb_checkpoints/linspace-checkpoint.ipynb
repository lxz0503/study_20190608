    "print(x)\n",
    "y = x*x*x\n",
    "\n",
    "# 取1到10之间等差分布的10个数\n",
    "z = np.linspace(1,10,10)\n",
    "print(z)\n",
    "\n",
    "plt.figure(figsize=(20,8),dpi=100)\n",
    "\n",
    "plt.plot(x,y)\n",
